; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Disording"
config/description="A 100-door advent calendar of tiny games."
config/version="0.1.0"
run/main_scene="res://menu/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0627451, 0.0588235, 0.137255, 1)
boot_splash/show_image=false
config/icon="res://web/icons/icon.svg"

[audio]

driver/output_latency.web=300

[autoload]

App="*res://autoload/app.gd"
SaveService="*res://autoload/save_service.gd"
Clock="*res://autoload/clock.gd"
Settings="*res://autoload/settings.gd"
DayRegistry="*res://autoload/day_registry.gd"
Calendar="*res://autoload/calendar.gd"
Telemetry="*res://autoload/telemetry.gd"
Haptics="*res://autoload/haptics.gd"
Gestures="*res://autoload/gestures.gd"
Bundles="*res://autoload/bundles.gd"
Audio="*res://autoload/audio_director.gd"
Router="*res://autoload/router.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/dpi/allow_hidpi=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0627451, 0.0588235, 0.137255, 1)
anti_aliasing/quality/msaa_2d=0
